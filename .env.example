# Values for the root compose.yaml. Copy to .env (gitignored); never commit it.
# One block per included component, same names as that component's own
# deploy/.env.example.

# --- engine (compose.local.yaml) ---
# Opt-in: the registry the engine and Smith images are pulled from
# (engine/README.md, "Images"), as <registry>/frakworks-*:main. Unset (the
# default), scripts/local-up.sh builds both images locally.
FRAKWORKS_REGISTRY=
# Its Postgres (engine-db). openssl rand -hex 24
ENGINE_DB_PASSWORD=
# Seals AI account credentials in the engine's database (engine/README.md,
# "AI accounts"). openssl rand -base64 32. Lose it and every stored credential
# has to be set again.
ENGINE_SECRETS_KEY=

# --- engine (compose.local.yaml): optional overrides ---
# Empty: engine/compose.local.yaml's default, named in each comment.
# The Smith image the engine pulls before a run (engine/README.md, "Smith runs").
# Default: frakworks-smith:main, the local build; <FRAKWORKS_REGISTRY>/frakworks-smith:main
# with a registry set. A :sha-<7> tag pins a registry build.
ENGINE_SMITH_IMAGE=
# How often the Smith image's :main is re-pulled at most (PT0S: every run). Default: PT5M.
ENGINE_SMITH_IMAGE_REFRESH_INTERVAL=
# Where the live transcript goes and is read back, and where read_transcript asks
# whether a run is live (engine/README.md, "Transcripts and the live-run gauge").
# Set to the defaults: compose reads these two without a colon, so an empty
# value is not the default but off (no transcript rows; liveness unknown).
ENGINE_TELEMETRY_LOGS_URL=http://victorialogs:9428
ENGINE_TELEMETRY_METRICS_URL=http://victoriametrics:8428
# The HITLP server the engine files its flow waits on (#2447) is no variable:
# set it once with PUT /settings/hitlp (engine/README.md, "The HITLP requester").

# --- observability (compose.local.yaml) ---
# Grafana at http://localhost:3000, user admin
GRAFANA_ADMIN_PASSWORD=

# --- engine: GitHub tokens are not set here ---
# Each target repo's GitHub token is given to the running engine and sealed on
# the repo's row: PUT /repos/{owner}/{name}/token, or Config > Repos in the
# desktop app (engine/README.md, "Each repo's token"). It needs ENGINE_SECRETS_KEY.
