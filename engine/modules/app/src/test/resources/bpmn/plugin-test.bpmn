<?xml version="1.0" encoding="UTF-8"?>
<!-- Test-only diagram standing in for a plugin's (sdk/CallableSmithProcessTest): a root that calls
     callable-smith with a prompt and a repo and reads its result, the way a plugin jar's diagram under
     bpmn/ would (engine/README.md, "Custom jobs and the SDK"): the variables named, never variables="all",
     as FlowRules.pluginProblems requires of a jar's diagram. Deployed in tests only (src/test/resources);
     drawn because BpmnStyleTest holds every diagram on the classpath to the house style. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="Definitions_plugin_test" targetNamespace="http://codefrak.com/engine/test">
  <bpmn:process id="plugin-test" name="plugin test" isExecutable="true" operaton:historyTimeToLive="1">
    <bpmn:startEvent id="start-plugin-test">
      <bpmn:outgoing>flow-plugin-to-smith</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="call-callable-smith" name="callable smith" calledElement="callable-smith" operaton:asyncBefore="true">
      <bpmn:extensionElements>
        <operaton:in source="prompt" target="prompt" />
        <operaton:in source="repo" target="repo" />
        <operaton:in source="jobId" target="jobId" />
        <operaton:in source="model" target="model" />
        <operaton:in source="effort" target="effort" />
        <operaton:in source="dryRun" target="dryRun" />
        <operaton:out source="result" target="result" />
        <operaton:out source="outcome" target="outcome" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-plugin-to-smith</bpmn:incoming>
      <bpmn:outgoing>flow-plugin-to-end</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="end-plugin-test">
      <bpmn:incoming>flow-plugin-to-end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-plugin-to-smith" sourceRef="start-plugin-test" targetRef="call-callable-smith" />
    <bpmn:sequenceFlow id="flow-plugin-to-end" sourceRef="call-callable-smith" targetRef="end-plugin-test" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_plugin_test">
    <bpmndi:BPMNPlane id="BPMNPlane_plugin_test" bpmnElement="plugin-test">
      <bpmndi:BPMNShape id="start-plugin-test-di" bpmnElement="start-plugin-test">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="call-callable-smith-di" bpmnElement="call-callable-smith">
        <dc:Bounds x="250" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end-plugin-test-di" bpmnElement="end-plugin-test">
        <dc:Bounds x="412" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-plugin-to-smith-di" bpmnElement="flow-plugin-to-smith">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="250" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-plugin-to-end-di" bpmnElement="flow-plugin-to-end">
        <di:waypoint x="350" y="120" />
        <di:waypoint x="412" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
