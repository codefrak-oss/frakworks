{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codefrak-oss/frakworks/engine/smith/schemas/review.schema.json",
  "title": "ReviewResult",
  "description": "What a review Smith writes to /work/out/result.json. The engine checks it (ReadResultDelegate) before its own rules; the Smith checks it with check-result review. Strict types where the engine branches, any non-empty JSON where it only passes content on.",
  "type": "object",
  "required": [
    "outcome"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "approved",
        "changes"
      ],
      "description": "Branched on by the engine and the BPMN."
    },
    "summary": {
      "$ref": "#/$defs/content"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ask"
        ],
        "properties": {
          "ask": {
            "$ref": "#/$defs/content"
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "content": {
      "description": "Passed on to a brief or a GitHub comment, never branched on: any non-empty JSON. A string is shown as itself; an object or array as a fenced JSON block.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "object",
          "minProperties": 1
        },
        {
          "type": "array",
          "minItems": 1
        },
        {
          "type": [
            "number",
            "boolean"
          ]
        }
      ]
    }
  }
}
