      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-dropped-end-di" bpmnElement="flow-dropped-end">
        <di:waypoint x="1380" y="440" />
        <di:waypoint x="1460" y="440" />
        <di:waypoint x="1460" y="298" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
