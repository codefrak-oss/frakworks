      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway-answer-outcome-di" bpmnElement="gateway-answer-outcome" isMarkerVisible="true">
        <dc:Bounds x="410" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="410" y="312" width="49" height="14" />
