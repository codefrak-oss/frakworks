      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway-ci-mergeable-di" bpmnElement="gateway-ci-mergeable" isMarkerVisible="true">
        <dc:Bounds x="670" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="666" y="73" width="58" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end-ci-conflict-di" bpmnElement="end-ci-conflict">
