# Runs on the user's Mac only, with the signing secrets from 1Password exported as the variables in .env.example
# (ios/README.md, "TestFlight"). Nothing here is a secret.
default_platform(:ios)

platform :ios do
  desc "Unit tests: FirstMateKit's parsers"
  lane :test do
    sh("cd ../FirstMateKit && swift test")
  end

  desc "Build, sign and upload a build to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
    )
    match(type: "appstore", readonly: true, api_key: api_key)
    increment_build_number(
      xcodeproj: "FirstMate/FirstMate.xcodeproj",
      build_number: latest_testflight_build_number(api_key: api_key) + 1,
    )
    build_app(project: "FirstMate/FirstMate.xcodeproj", scheme: "FirstMate", export_method: "app-store")
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
